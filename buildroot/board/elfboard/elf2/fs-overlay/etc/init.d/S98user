#! /bin/sh

case "$1" in 
    start)
	mkdir /home
        adduser elf << EOF
elf
elf

EOF
     rm /etc/init.d/S98user
     sync
     ;;
    stop)
        ;;
    
    restart|reload)
        $0 stop
        $0 start
        ;;
    
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac
