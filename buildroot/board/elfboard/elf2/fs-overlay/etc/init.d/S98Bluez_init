#! /bin/sh
case "$1" in
  start)
	export DBUS_SESSION_BUS_ADDRESS=unix:path=/var/run/dbus/system_bus_socket
	/usr/bin/obexd -a -r /tmp &
        echo "OK"
        ;;
  stop)
        echo "OK"
        ;;
  restart|force-reload)
        $0 stop
        sleep 1
        $0 start
        echo ""
        ;;
  *)
        echo "Usage: $0 {start|stop|restart|force-reload}" >&2
        exit 1
        ;;
esac

exit 0

