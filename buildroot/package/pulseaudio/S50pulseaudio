#!/bin/sh
#
# Starts pulseaudio.
#


start() {
	printf "Starting pulseaudio: "
	umask 077
	PULSE_HOME=/userdata/.pulse /usr/bin/pulseaudio &
#		--system \
#		--daemonize \
#		--disallow-module-loading \
#		--disallow-exit \
#		--exit-idle-time=-1 \
#		--use-pid-file \
#		--disable-shm
	sleep 1
	res=`pactl  list sinks | grep alsa_output.platform-nau8822-sound.stereo-fallback`
	if [ "res" != "" ];then
		pactl set-default-sink alsa_output.platform-nau8822-sound.stereo-fallback
	fi

	echo "OK"
}
stop() {
	printf "Stopping pulseaudio: "
	PULSE_RUNTIME_PATH=/var/run/pulse /usr/bin/pulseaudio --kill
	echo "OK"
}
restart() {
	stop
	start
}

case "$1" in
  start)
	start
	;;
  stop)
	stop
	;;
  restart|reload)
	restart
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?

